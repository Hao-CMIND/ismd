{
  "name": "pug-rust-compiler",
  "version": "2.0.4-rust.1",
  "description": "Rust + Oxc implementation of the Pug template compiler, compatible with pug@2.0.4",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./register": "./register.js",
    "./runtime": "./runtime/index.js"
  },
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "register.js",
    "runtime/",
    "pug-napi.win32-x64-msvc.node",
    "README.md",
    "compat/matrix.md",
    "compat/expected-differences.json"
  ],
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "napi": {
    "name": "pug-napi",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "scripts": {
    "build": "cargo build -p pug_napi",
    "test": "npm run test:integration",
    "test:rust": "cargo test --workspace",
    "test:integration": "node --test tests/integration/skeleton.test.js tests/integration/template-store.test.js tests/integration/compiler-session.test.js tests/integration/js-api.test.js tests/integration/core-decoupling.test.js",
    "test:skeleton": "node tests/integration/skeleton.test.js",
    "test:lexer": "node tests/integration/lexer.test.js",
    "test:step1": "node tests/integration/skeleton.test.js",
    "test:step2": "node tests/integration/lexer.test.js",
    "test:diff": "node tests/differential/runner.js",
    "test:diff:baseline": "node tests/differential/runner.js --verify-baseline",
    "test:serializers": "node tests/differential/serializers.test.js",
    "compat:baseline": "node tests/differential/generate-baseline.js",
    "test:native": "node --test tests/integration/native-plugin-poc.test.js tests/integration/core-decoupling.test.js",
    "test:diff:core": "node --test tests/differential/core-decoupling.test.js",
    "test:audit": "node scripts/audit-core-decoupling.mjs"
  }
}
