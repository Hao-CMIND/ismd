{
  "name": "ismd-workspace",
  "version": "0.1.0",
  "description": "High-performance ISMD template compiler in Rust with Vite and Webpack adapters",
  "private": true,
  "type": "module",
  "workspaces": [
    "ismd",
    "ismd-cli",
    "vite-plugin-ismd",
    "ismd-webpack-plugin",
    "ismd-filters",
    "ismd-lint",
    "benchmarks"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:ismd": "npm test --workspace=ismd",
    "test:cli": "npm test --workspace=ismd-cli",
    "test:vite": "npm test --workspace=vite-plugin-ismd",
    "test:webpack": "npm test --workspace=ismd-webpack-plugin",
    "test:filters": "npm test --workspace=ismd-filters",
    "test:benchmarks": "node benchmarks/bundler.mjs"
  }
}
